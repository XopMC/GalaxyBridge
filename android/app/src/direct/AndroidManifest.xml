<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <activity android:name=".FileShareActivity" android:exported="true"
            android:label="@string/file_send_title" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <service android:name=".service.GalaxyInCallService" android:exported="true" android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <receiver android:name=".catalog.ApplicationCatalogExportReceiver" android:enabled="true" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.xopmc.galaxybridge.EXPORT_APPLICATION_CATALOG" />
            </intent-filter>
        </receiver>
        <receiver android:name=".service.RemoteTextInputReceiver" android:enabled="true" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.xopmc.galaxybridge.INJECT_REMOTE_TEXT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
