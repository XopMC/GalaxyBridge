+// A handle remains owned until every admitted synchronous transfer returns.
+// Readers and writers share the handle lock: an idle read never delays input.
+// Only idle/error waits are polled; available bytes are transferred immediately.
+int LibUsbDevice::BulkTransfer(uint8_t endpoint, unsigned char* data, int length,
+                              int* transferred) {
+    *transferred = 0;
+    if (closing_.load(std::memory_order_acquire)) return LIBUSB_ERROR_NO_DEVICE;
+    std::shared_lock<std::shared_mutex> lock(handle_mutex_);
+    if (closing_.load(std::memory_order_acquire) || device_handle_ == nullptr ||
+        !interface_claimed_) return LIBUSB_ERROR_NO_DEVICE;
+    while (true) {
+        if (closing_.load(std::memory_order_acquire)) return LIBUSB_ERROR_NO_DEVICE;
+        int count = 0;
+        int remaining = length - *transferred;
+        int result = libusb_bulk_transfer(device_handle_, endpoint, data + *transferred,
+                                         remaining, &count, 100);
+        if (count < 0 || count > remaining) return LIBUSB_ERROR_OTHER;
+        *transferred += count;
+        if (result != LIBUSB_ERROR_TIMEOUT) return result;
+        // A timed-out transfer may already have delivered bytes. Continue from
+        // its exact offset; replaying a prefix corrupts ADB packet framing.
+        if (length > 0 && *transferred == length) return 0;
     }
 }
 
