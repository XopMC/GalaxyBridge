@@ -0,0 +1,12 @@
+/* Galaxy Bridge changes, 2026. LGPL-2.1-or-later, same as libusb.
+ * Ordinary open is attempted exactly once. Busy/errors are propagated; there
+ * is no detach, seize, reset, configuration change, or fallback callback. */
+#ifndef GALAXYBRIDGE_USB_POLICY_H
+#define GALAXYBRIDGE_USB_POLICY_H
+static inline int galaxybridge_usb_open_once(void *device, int (*ordinary_open)(void *)) {
+  return ordinary_open(device);
+}
+static inline int galaxybridge_usb_reject_mutation(void) {
+  return -12; /* LIBUSB_ERROR_NOT_SUPPORTED */
+}
+#endif
