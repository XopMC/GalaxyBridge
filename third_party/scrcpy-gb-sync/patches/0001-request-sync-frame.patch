+    @Test public void resetCannotClearOwnerUntilBlockedApiReturns() throws Exception {
+        Fixture f = new Fixture();
+        CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1), resetting = new CountDownLatch(1);
+        f.ops.packet = () -> Assert.assertEquals(QUEUED, f.queue(1, 1));
+        f.ops.sync = () -> { entered.countDown(); await(release); };
+        AtomicReference<Throwable> error = new AtomicReference<>();
+        Thread video = thread(error, () -> { try { f.run(); } catch (IOException e) { throw new AssertionError(e); } });
+        await(entered);
+        Thread reset = thread(error, () -> { resetting.countDown(); f.control.reset(CaptureControl.RESET_REASON_CLIENT_RESET); });
+        await(resetting);
+        // Monitor contention is deterministic: reset cannot enter while the codec callback holds it.
+        long end = System.nanoTime() + TimeUnit.SECONDS.toNanos(2);
+        while (reset.getState() != Thread.State.BLOCKED && System.nanoTime() < end) { Thread.yield(); }
+        Assert.assertEquals(Thread.State.BLOCKED, reset.getState());
+        release.countDown();
+        join(video, error); join(reset, error);
+        Assert.assertEquals(1, f.ops.calls);
+        Assert.assertEquals(REJECTED, f.queue(1, 1));
+    }
