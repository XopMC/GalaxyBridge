+    private void assertPartialConfigAndReleaseFailure(RuntimeException cleanup) throws Exception {
+        Fixture f = new Fixture();
+        IOException partial = new IOException("config after partial progress");
+        f.ops.packet = () -> {
+            f.ops.events.add("partial-byte");
+            throw partial;
+        };
+        f.ops.released = () -> { throw cleanup; };
+        SurfaceEncoder.PublicationException terminal = Assert.assertThrows(SurfaceEncoder.PublicationException.class,
+                () -> f.encoder.runCycle(f.ops, 640, 480, false, error -> {
+                    f.ops.retries++;
+                    return true; // A retryable classification must fail this oracle.
+                }));
+        Assert.assertSame(partial, terminal.getCause());
+        Assert.assertArrayEquals(new Throwable[] {cleanup}, terminal.getSuppressed());
+        Assert.assertEquals(0, f.ops.retries);
+        Assert.assertEquals(1, java.util.Collections.frequency(f.ops.events, "configure"));
+        Assert.assertEquals(1, java.util.Collections.frequency(f.ops.events, "codec-start"));
+        Assert.assertEquals(1, java.util.Collections.frequency(f.ops.events, "partial-byte"));
+        Assert.assertEquals(1, java.util.Collections.frequency(f.ops.events, "release:0"));
+        Assert.assertEquals(0, f.ops.calls);
+        Assert.assertEquals(REJECTED, f.queue(1, 1));
+        Assert.assertThrows(IllegalStateException.class, f.control::service); // Owner was cleared.
+        // Retirement, not only clearance: rebinding cannot revive this partial stream.
+        f.control.bind(f.ops);
+        f.encoder.publish(true, () -> {});
+        f.encoder.publish(false, () -> {});
+        Assert.assertEquals(REJECTED, f.queue(2, 1));
+        Assert.assertEquals(NONE, f.control.service());
+        f.control.clearOwner();
+    }
